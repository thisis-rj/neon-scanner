import Link from "next/link";
import { StarIcon } from "lucide-react";
import { supabaseServer } from "@/lib/supabase";
import { getWatchlist } from "@/lib/watchlist";
import { fmtUsd } from "@/lib/format";
import { WatchlistToggle } from "@/components/WatchlistToggle";
import { filerInfoByName, filerShortLabel } from "@/lib/filers";
import { PageHeader } from "@/components/app/page-header";
import { TableCard } from "@/components/app/table-card";
import { Pct, ThirteenFDelayNote, Ticker, TierBadge } from "@/components/app/cells";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from "@/components/ui/empty";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectGroup,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Tooltip, TooltipContent, TooltipTrigger } from "@/components/ui/tooltip";

// Force dynamic rendering — same reason as /holdings. Statically rendered
// pages serve build-time data; this page reads from signals_latest which
// changes hourly during filing seasons.
export const dynamic = "force-dynamic";

// /signals — BUY signal table, read from signals_latest.
// Default threshold: score ≥ 7. Filter at top: text box "min score".

// Insiders the filters dropped (config/signal_weights.yml `insider_filters`).
// Listed next to the score so a filtered-out buyer is never invisible (§2.4).
type ExcludedInsider = { name: string | null; reason: string };
const EXCLUSION_REASON: Record<string, string> = {
  not_officer_or_director: "not an officer or director",
  "10b5_1_plan": "pre-scheduled 10b5-1 plan",
  below_min_value: "under $25k",
  stake_growth_below_min: "grew stake <10%",
};

function ExcludedList({ list }: { list: ExcludedInsider[] }) {
  return (
    <>
      <span className="font-medium">Not counted ({list.length}):</span>
      {list.map((e, i) => (
        <span key={i}>
          {e.name ?? "Unknown"} — {EXCLUSION_REASON[e.reason] ?? e.reason}
        </span>
      ))}
    </>
  );
}

type Signal = {
  ticker: string;
  score: number;
  num_sources: number;
  components: {
    insider_cluster?: { n: number; score: number; excluded?: ExcludedInsider[] };
    thirteenf_new?: { n: number; score: number };
    thirteenf_add?: { n: number; score: number };
    activist_13d?: { n: number; score: number };
    share_velocity?: { n: number; score: number };
    cross_q_confluence?: { n: number; score: number };
    multi_source_bonus?: { applied: boolean; n_types: number; score: number };
  };
  contributing_filers: {
    new?: string[];
    add?: string[];
    velocity?: [string, number][];
    activist?: string[];
    insider_buyers?: string[];
  } | null;
  first_detected_at: string | null;
  latest_signal_at: string | null;
  aum_usd: number | null;
  price: number | null;
  return_1m: number | null;
  return_6m: number | null;
  return_ytd: number | null;
  computed_at: string;
};


type SortKey = "score" | "latest_signal" | "first_detected";

async function fetchSignals(sort: SortKey): Promise<(Signal & { company_name: string | null })[]> {
  const sb = supabaseServer();
  const col = sort === "latest_signal" ? "latest_signal_at"
            : sort === "first_detected" ? "first_detected_at"
            : "score";
  // Fetch signals + tickers.name in one trip
  const out: Signal[] = [];
  let from = 0;
  while (true) {
    const { data, error } = await sb
      .from("signals_latest")
      .select("*")
      .order(col, { ascending: false, nullsFirst: false })
      .order("score", { ascending: false })
      .range(from, from + 999);
    if (error) throw error;
    if (!data || data.length === 0) break;
    out.push(...(data as Signal[]));
    if (data.length < 1000) break;
    from += 1000;
  }
  // Fetch ticker→name map (companies in our universe)
  const tickerSet = Array.from(new Set(out.map((s) => s.ticker)));
  const nameMap = new Map<string, string>();
  for (let i = 0; i < tickerSet.length; i += 500) {
    const batch = tickerSet.slice(i, i + 500);
    const { data } = await sb
      .from("tickers")
      .select("ticker,name")
      .in("ticker", batch);
    for (const row of data || []) {
      if (row.ticker && row.name) nameMap.set(row.ticker, row.name);
    }
  }
  return out.map((s) => ({ ...s, company_name: nameMap.get(s.ticker) ?? null }));
}

// Component key → short label + plain-English meaning. Shown as one badge
// per firing component so the score is never separated from its parts (§2.4).
const COMPONENTS: { key: keyof Signal["components"]; short: string; long: string }[] = [
  { key: "insider_cluster", short: "ins", long: "Insiders buying (30-day cluster)" },
  { key: "thirteenf_new", short: "new", long: "13F new positions" },
  { key: "thirteenf_add", short: "add", long: "13F adds (≥20%)" },
  { key: "activist_13d", short: "13d", long: "Activist 13D" },
  { key: "share_velocity", short: "vel", long: "Share-count velocity (≥2× Q/Q)" },
  { key: "cross_q_confluence", short: "xq", long: "Cross-quarter confluence (3+ filers, 2 quarters)" },
];

const PRESETS = [
  { score: 7, label: "Clean signal" },
  { score: 15, label: "High confluence" },
  { score: 20, label: "Top tier" },
];

export default async function SignalsPage({
  searchParams,
}: {
  searchParams: Promise<{ min_score?: string; sort?: string }>;
}) {
  const sp = await searchParams;
  const minScore = sp.min_score ? parseFloat(sp.min_score) : 7;
  const sortKey: SortKey = sp.sort === "latest_signal" ? "latest_signal"
                        : sp.sort === "first_detected" ? "first_detected"
                        : "score";
  const [allSignals, watchlistSet] = await Promise.all([fetchSignals(sortKey), getWatchlist()]);
  const signals = allSignals.filter((s) => s.score >= minScore);
  const totalCount = allSignals.length;
  const lastComputed = allSignals[0]?.computed_at ?? null;

  return (
    <div className="flex flex-col gap-8">
      <PageHeader
        title="Signals"
        description="Tickers where several smart-money sources are firing at once. The score is a transparent sum of named filing types — every component is shown next to it. No LLM, no advice: just what the filings say."
        meta={
          <>
            <span>
              <span className="font-medium text-foreground tabular-nums">{totalCount}</span> computed
              {lastComputed ? ` · ${new Date(lastComputed).toLocaleString()}` : ""}
            </span>
            <span>
              <span className="font-medium text-foreground tabular-nums">{signals.length}</span> with score ≥ {minScore}
            </span>
            <span>
              <span className="font-medium text-foreground tabular-nums">{watchlistSet.size}</span> watchlisted
            </span>
            <ThirteenFDelayNote />
          </>
        }
      />

      <Card size="sm">
        <CardContent>
          <form method="get" className="flex flex-wrap items-end gap-x-4 gap-y-3">
            <div className="flex flex-col gap-1.5">
              <Label htmlFor="min_score" className="text-xs text-muted-foreground">Min score</Label>
              <Input
                id="min_score"
                name="min_score"
                type="number"
                defaultValue={minScore}
                step="0.5"
                min="0"
                className="w-24 tabular-nums"
              />
            </div>
            <div className="flex flex-col gap-1.5">
              <Label htmlFor="sort" className="text-xs text-muted-foreground">Sort by</Label>
              <Select name="sort" defaultValue={sortKey}>
                <SelectTrigger id="sort" className="w-52">
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectGroup>
                    <SelectItem value="score">Score (high → low)</SelectItem>
                    <SelectItem value="latest_signal">Latest signal (newest)</SelectItem>
                    <SelectItem value="first_detected">First detected (newest)</SelectItem>
                  </SelectGroup>
                </SelectContent>
              </Select>
            </div>
            <Button type="submit">Apply</Button>
            <div className="flex flex-wrap items-center gap-1.5 md:ml-auto">
              <span className="text-xs text-muted-foreground">Presets</span>
              {PRESETS.map((p) => (
                <Button
                  key={p.score}
                  asChild
                  size="sm"
                  variant={minScore === p.score ? "secondary" : "outline"}
                >
                  <Link href={`/signals?min_score=${p.score}&sort=${sortKey}`}>
                    <span className="font-mono tabular-nums">{p.score}</span>
                    <span className="text-muted-foreground">{p.label}</span>
                  </Link>
                </Button>
              ))}
            </div>
          </form>
        </CardContent>
      </Card>

      <TableCard
        title="Buy confluence"
        description={
          <>
            <StarIcon className="inline size-3 fill-warning text-warning" /> marks the multi-source bonus
            (+5 when 3+ signal types fire on one ticker). Hover a component badge for what it counts.
          </>
        }
      >
        {signals.length === 0 ? (
          <Empty className="py-16">
            <EmptyHeader>
              <EmptyTitle>No signals at score ≥ {minScore} — this is normal</EmptyTitle>
              <EmptyDescription>
                Most weeks nothing clears the bar. That is the system working, not failing. Lower the
                threshold only if you want to see weaker evidence.
              </EmptyDescription>
            </EmptyHeader>
          </Empty>
        ) : (
          <Table>
            <TableHeader>
              <TableRow className="hover:bg-transparent">
                <TableHead className="w-10 pl-6"><span className="sr-only">Watchlist</span></TableHead>
                <TableHead>Ticker</TableHead>
                <TableHead className="text-right">Score</TableHead>
                <TableHead>Components</TableHead>
                <TableHead>Top filers</TableHead>
                <TableHead>Detected</TableHead>
                <TableHead className="text-right">Mkt cap</TableHead>
                <TableHead className="text-right">1M</TableHead>
                <TableHead className="text-right">6M</TableHead>
                <TableHead className="pr-6 text-right">YTD</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {signals.map((s) => {
                const c = s.components || {};
                const firing = COMPONENTS.filter((k) => (c[k.key] as { n?: number } | undefined)?.n);
                const star = c.multi_source_bonus?.applied;
                // Top filers across signal types, activists first, de-duplicated.
                const cf = s.contributing_filers || {};
                const ordered = [
                  ...(cf.activist ?? []),
                  ...(cf.velocity ?? []).map(([f]) => f),
                  ...(cf.new ?? []),
                  ...(cf.add ?? []),
                  ...(cf.insider_buyers ?? []),
                ];
                const filers = Array.from(new Set(ordered));
                return (
                  <TableRow key={s.ticker}>
                    <TableCell className="pl-6">
                      <WatchlistToggle ticker={s.ticker} initialAdded={watchlistSet.has(s.ticker)} />
                    </TableCell>
                    <TableCell className="max-w-56">
                      <div className="flex flex-col leading-tight">
                        <Ticker className="text-sm">{s.ticker}</Ticker>
                        <span className="truncate text-xs text-muted-foreground" title={s.company_name ?? ""}>
                          {s.company_name ?? "—"}
                        </span>
                      </div>
                    </TableCell>
                    <TableCell className="text-right">
                      <div className="flex items-center justify-end gap-1.5">
                        {star && (
                          <Tooltip>
                            <TooltipTrigger asChild>
                              <StarIcon className="size-3.5 fill-warning text-warning" aria-label="Multi-source bonus" />
                            </TooltipTrigger>
                            <TooltipContent>Multi-source bonus — 3+ signal types firing</TooltipContent>
                          </Tooltip>
                        )}
                        <span className="text-base font-semibold tabular-nums">{s.score.toFixed(1)}</span>
                      </div>
                      <div className="text-[11px] text-muted-foreground tabular-nums">
                        {s.num_sources} source{s.num_sources === 1 ? "" : "s"}
                      </div>
                    </TableCell>
                    <TableCell className="whitespace-normal">
                      <div className="flex w-36 flex-wrap gap-1">
                        {firing.map((k) => {
                          const v = c[k.key] as { n: number; score: number };
                          return (
                            <Tooltip key={k.key}>
                              <TooltipTrigger asChild>
                                <Badge variant="muted" className="cursor-help rounded-sm px-1.5 font-mono text-[11px]">
                                  {k.short}
                                  <span className="text-foreground">{v.n}</span>
                                </Badge>
                              </TooltipTrigger>
                              <TooltipContent className="flex-col items-start">
                                <span>{k.long}: {v.n} · +{v.score.toFixed(1)} pts</span>
                                {k.key === "insider_cluster" && c.insider_cluster?.excluded?.length ? (
                                  <ExcludedList list={c.insider_cluster.excluded} />
                                ) : null}
                              </TooltipContent>
                            </Tooltip>
                          );
                        })}
                        {!c.insider_cluster?.n && c.insider_cluster?.excluded?.length ? (
                          <Tooltip>
                            <TooltipTrigger asChild>
                              <Badge variant="outline" className="cursor-help rounded-sm px-1.5 font-mono text-[11px] text-muted-foreground line-through">
                                ins<span>{c.insider_cluster.excluded.length}</span>
                              </Badge>
                            </TooltipTrigger>
                            <TooltipContent className="flex-col items-start">
                              <span>Insider buys in the last 30 days, none counted</span>
                              <ExcludedList list={c.insider_cluster.excluded} />
                            </TooltipContent>
                          </Tooltip>
                        ) : null}
                      </div>
                    </TableCell>
                    <TableCell className="whitespace-normal">
                      <div className="flex min-w-44 flex-col gap-1">
                        {filers.slice(0, 2).map((fullName) => {
                          const info = filerInfoByName(fullName);
                          return (
                            <div key={fullName} className="flex items-center gap-1.5 text-xs" title={info?.badge || fullName}>
                              <TierBadge tier={info?.signalTier ?? "B"} />
                              <span className="truncate">{filerShortLabel(fullName)}</span>
                              {info?.badge && (
                                <span className="hidden truncate text-muted-foreground 2xl:inline">· {info.badge}</span>
                              )}
                            </div>
                          );
                        })}
                        {filers.length > 2 && (
                          <Tooltip>
                            <TooltipTrigger asChild>
                              <span className="w-fit cursor-help text-[11px] text-muted-foreground">
                                +{filers.length - 2} more
                              </span>
                            </TooltipTrigger>
                            <TooltipContent className="flex-col items-start">
                              {filers.slice(2).map((f) => <span key={f}>{filerShortLabel(f)}</span>)}
                            </TooltipContent>
                          </Tooltip>
                        )}
                      </div>
                    </TableCell>
                    <TableCell>
                      <div className="flex flex-col font-mono text-[11px] leading-tight tabular-nums">
                        <span title="Latest filing date among contributing signals">{s.latest_signal_at ?? "—"}</span>
                        <span className="text-muted-foreground" title="Earliest filing date among contributing signals">
                          since {s.first_detected_at ?? "—"}
                        </span>
                      </div>
                    </TableCell>
                    <TableCell className="text-right tabular-nums">{fmtUsd(s.aum_usd)}</TableCell>
                    <TableCell className="text-right"><Pct value={s.return_1m} /></TableCell>
                    <TableCell className="text-right"><Pct value={s.return_6m} /></TableCell>
                    <TableCell className="pr-6 text-right"><Pct value={s.return_ytd} /></TableCell>
                  </TableRow>
                );
              })}
            </TableBody>
          </Table>
        )}
      </TableCard>

      <p className="max-w-4xl text-xs leading-relaxed text-pretty text-muted-foreground">
        Score components: insider cluster (Lakonishok-Lee, 30-day window; counts officers and directors
        buying $25k+ outside a 10b5-1 plan that grows their stake 10%+), 13F new positions, 13F adds
        (≥20%), activist 13D, share-count velocity (≥2× quarter over quarter), cross-quarter confluence
        (3+ distinct filers across 2 quarters), plus a +5 multi-source bonus when 3+ types fire. Refreshed
        nightly. Returns from yfinance.
      </p>
    </div>
  );
}

# Copy to .env and fill in. Never commit .env.

# ─── Supabase ─────────────────────────────────────────────────────────────
# New-style API keys (sb_publishable_... and sb_secret_...). The legacy
# anon/service_role keys still work if you choose that tab instead, but new
# projects should use these.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Personal Access Token — ONLY needed to apply schema migrations
# (ingest/migrate.py drives the Supabase Management API). Generate at
# https://supabase.com/dashboard/account/tokens. Full-project power — treat it
# like a root password. Skip it if you're not running migrations.
SUPABASE_PAT=

# ─── EDGAR ────────────────────────────────────────────────────────────────
# SEC requires a User-Agent identifying the requester with a contact email.
# https://www.sec.gov/os/accessing-edgar-data
EDGAR_USER_AGENT="portfolio-scanner riya1910jain@gmail.com"

# ─── Price data ───────────────────────────────────────────────────────────
# yfinance has no key. Switch to polygon/iexcloud later if rate-limited.
# POLYGON_API_KEY=

# ─── LLM (Groq) ───────────────────────────────────────────────────────────
# Free-tier LLM for summarizing 8-Ks and (later) 13D Item 4 intents.
# Get a key at https://console.groq.com — 30 req/min / 1000 req/day on free.
GROQ_API_KEY=
